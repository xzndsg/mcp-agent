# ============ LLM 配置（OpenAI 兼容接口，三选一即可） ============
# 可选值：deepseek / zhipu / openai
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# 可选：覆盖默认模型与网关地址（不配则使用各厂商默认值）
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.7

# ============ 服务配置 ============
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# 运行时数据目录（MCP 服务器配置、工具状态、日志）
MCP_AGENT_DATA_DIR=./data

# 自动连接已配置且标记 autostart 的 MCP 服务器
MCP_AGENT_AUTOSTART=true

# ============ 能力层（接口平台） ============
# TTS 默认音色（edge-tts，免费无 Key）
MCP_AGENT_TTS_VOICE=zh-CN-XiaoxiaoNeural
# 接口平台 OpenAI 兼容端点的 Bearer 鉴权（留空则不鉴权）
MCP_AGENT_API_TOKEN=
